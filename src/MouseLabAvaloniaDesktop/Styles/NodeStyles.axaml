<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Classes="node"
                Width="8"
                Height="8"
                CornerRadius="8">
          <TextBlock Classes="nodeId" Text="0" />
        </Border>
        <Border Classes="node selected"
                Width="8"
                Height="8"
                CornerRadius="8">
          <TextBlock Classes="nodeId selected" Text="1" />
        </Border>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <Style Selector="Border.node">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="Black"/>
    <Setter Property="BorderThickness" Value="0.8"/>
  </Style>
  <Style Selector="Border.node.selected">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#FF3D7EFF"/>
    <Setter Property="BorderThickness" Value="1.2"/>
    <Setter Property="BoxShadow" Value="0 1. 1.2 1.4 #fff00000"/>
  </Style>
  <Style Selector="TextBlock.nodeId">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="2"/>
  </Style>
  <Style Selector="TextBlock.nodeId.selected">
    <Setter Property="FontSize" Value="2"/>
    <Setter Property="FontWeight" Value="UltraBold"/>
  </Style>
</Styles>
