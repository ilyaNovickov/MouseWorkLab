<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             xmlns:vm="using:MouseLabAvaloniaDesktop.ViewModels.Worktop"
             x:Class="MouseLabAvaloniaDesktop.Views.WorktopCanvasView"
             x:DataType="vm:WorktopCanvasViewModel">
    <Canvas Background="red">
        <Image Name="image" Source="{Binding Worktop, 
                        Converter={StaticResource MatrixToImage}, 
                        Mode=OneWay}"/>
    </Canvas>
</UserControl>
