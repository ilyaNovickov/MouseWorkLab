<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MouseLabAvaloniaDesktop.ViewModels.Worktop.NodesAndMore"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:b="using:MouseLabAvaloniaDesktop.Behaviors"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:ConnectionViewModel"
             x:Class="MouseLabAvaloniaDesktop.Views.ConnectionView"
              ClipToBounds="False">
  <i:Interaction.Behaviors>
    <b:ConnectionPointerBehavior />
  </i:Interaction.Behaviors>

  <Canvas>
    <!-- Основная линия -->
    <Panel>
      <Path Classes="edge"
            Classes.selected="{Binding IsSelected}"
            Data="{Binding #hitPath.Data}"
            IsHitTestVisible="False"/>

      <!-- Стрелка -->
      <Path Classes="arrow"
            Classes.selected="{Binding IsSelected}"
            IsHitTestVisible="False">
        <Path.Data>
          <MultiBinding Converter="{StaticResource ArrowGeometry}">
            <Binding Path="ArrowFrom" />
            <Binding Path="ArrowTo" />
          </MultiBinding>
        </Path.Data>
      </Path>

      <!-- Прозрачная область для клика -->
      <Path Name="hitPath"
            Classes="hit"
            Classes.interactive="{Binding CanInteract}"
            Classes.deleting="{Binding CanDelete}"
            Stroke="Transparent"
            StrokeThickness="14">
        <Path.Data>
          <MultiBinding Converter="{StaticResource ConnectionGeometry}">
            <Binding Path="Start" />
            <Binding Path="End" />
            <Binding Path="Control1" />
            <Binding Path="Control2" />
            <Binding Path="Kind" />
          </MultiBinding>
        </Path.Data>
      </Path>
    </Panel>

      <!-- Направляющие линии к контрольным точкам -->
      <Line Classes="guide"
            IsVisible="{Binding ShowHandles}"
            IsHitTestVisible="False"
            StartPoint="{Binding Start, Converter={StaticResource PointDToPoint}}"
            EndPoint="{Binding Control1, Converter={StaticResource PointDToPoint}}" />
      <Line Classes="guide"
            IsVisible="{Binding ShowHandles}"
            IsHitTestVisible="False"
            StartPoint="{Binding End, Converter={StaticResource PointDToPoint}}"
            EndPoint="{Binding Control2, Converter={StaticResource PointDToPoint}}" />

      <!-- Ручки Безье -->
       <Ellipse Classes="handle"
                IsVisible="{Binding ShowHandles}"
                Canvas.Left="{Binding Control1.X}"
                Canvas.Top="{Binding Control1.Y}">
         <i:Interaction.Behaviors>
           <b:BezierHandleDragBehavior HandleIndex="0" CanDrag="{Binding ShowHandles}" />
         </i:Interaction.Behaviors>
         <Ellipse.RenderTransform>
          <TranslateTransform X="-6" Y="-6" />
        </Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Classes="handle"
               IsVisible="{Binding ShowHandles}"
               Canvas.Left="{Binding Control2.X}"
               Canvas.Top="{Binding Control2.Y}">
        <i:Interaction.Behaviors>
          <b:BezierHandleDragBehavior HandleIndex="1" CanDrag="{Binding ShowHandles}" />
        </i:Interaction.Behaviors>
        <Ellipse.RenderTransform>
          <TranslateTransform X="-6" Y="-6" />
        </Ellipse.RenderTransform>
      </Ellipse>
  </Canvas>
</UserControl>
