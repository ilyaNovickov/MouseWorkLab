<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:MouseLabAvaloniaDesktop.ViewModels.Worktop"
             xmlns:vmN="using:MouseLabAvaloniaDesktop.ViewModels.Worktop.NodesAndMore"
             xmlns:paz="using:Avalonia.Controls.PanAndZoom"
             xmlns:v="using:MouseLabAvaloniaDesktop.Views"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:b="using:MouseLabAvaloniaDesktop.Behaviors"
             x:Class="MouseLabAvaloniaDesktop.Views.WorktopView"
             x:DataType="vm:WorktopViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.center">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1,0,1,0"/>
        </Style>
    </UserControl.Styles>
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <RadioButton Content="Панорама"
                         GroupName="WorkspaceMode"
                         IsChecked="{Binding IsPanOnlyMode, Mode=TwoWay}" />
            <RadioButton Content="Выбор"
                         GroupName="WorkspaceMode"
                         IsChecked="{Binding IsSelectAndMoveMode, Mode=TwoWay}" />
            <RadioButton Content="Удаление"
                         GroupName="WorkspaceMode"
                         IsChecked="{Binding IsDeleteMode, Mode=TwoWay}" />
            <RadioButton Content="Добавление"
                         GroupName="WorkspaceMode"
                         IsChecked="{Binding IsAddMode, Mode=TwoWay}" />
            <TextBlock Classes="center"
                       Text="{Binding Strings.WorktopConnectionKind}" />
            <ComboBox ItemsSource="{Binding ConnectionKindOptions}"
                      SelectedItem="{Binding SelectedConnectionKindOption}"
                      IsEnabled="{Binding HasSelectedConnection}"
                      MinWidth="110">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName.Value}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Name="saveDebugImageButton"
                    Content="Снимок"
                    IsVisible="False"
                    Click="SaveDebugImage_Click" />
        </Menu>
        <Border DockPanel.Dock="Bottom"
                Margin="5,5,5,5"
                BorderBrush="Red"
                BorderThickness="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Classes="center" Grid.Column="0" Text="Сид"/>
                <TextBox Grid.Column="1"
                         Name="seedTextBox"
                         Margin="3,5,0,5"
                         Width="120"
                         MinWidth="120"
                         MaxWidth="120"
                         TextInputOptions.ContentType="Number"
                         Text="{Binding Seed}">
                    <TextBox.InnerRightContent>
                        <Button Content="✕"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4"
                                Command="{Binding #seedTextBox.Clear}" />
                    </TextBox.InnerRightContent>
                </TextBox>
                <Button Grid.Column="2"
                        Margin="3,3,3,3"
                        Content="Генерация"
                        Command="{Binding GenerateWorktopCommand}" />
                <TextBlock Classes="center" 
                            Grid.Column="4" 
                            Text="Масштаб"/>
                <TextBlock Classes="center" 
                           Grid.Column="5" 
                           Text="{Binding #zoomBorder.ZoomX, StringFormat={}{0:0.00}}"/>
                <StackPanel Grid.Column="6" 
                            Orientation="Horizontal" 
                            Margin="3,3,3,3">
                    <Button Content="+" 
                            Command="{Binding #zoomBorder.ZoomInCommand}" />
                    <Button Content="-" 
                            Command="{Binding #zoomBorder.ZoomOutCommand}" />
                    <Button Content="Сброс"
                            Command="{Binding #zoomBorder.FitCommand}" />
                </StackPanel>
                
            </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <paz:ZoomBorder Name="zoomBorder"
                            PanButton="{Binding PanButton}"
                            DoubleClickZoomMode="None"
                            MinZoomX="0.2"
                            MinZoomY="0.2"
                            Background="DimGray"
                            AutoCalculateMaxZoom="True"
                            MaxZoomPixelSize="100" >


                <Border BorderBrush="Black"
                        BorderThickness="1"
                        Width="{Binding AvailableResolution}"
                        Height="{Binding AvailableResolution}">
                    <Canvas Name="mainCanvas"
                            Width="{Binding AvailableResolution}"
                            Height="{Binding AvailableResolution}"
                            Background="Gray" >
                        <i:Interaction.Behaviors>
                            <b:CanvasPointerBehavior Viewport="{Binding #zoomBorder}" />
                        </i:Interaction.Behaviors>
                        <Image Name="worktop"
                               RenderOptions.BitmapInterpolationMode="LowQuality"
                               Source="{Binding Worktop, Converter={StaticResource MatrixToImage}, Mode=OneWay}"
                               Canvas.Left="{Binding WorktopPosition}"
                               Canvas.Top="{Binding WorktopPosition}" />

                            <ItemsControl ItemsSource="{Binding Connections}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="{Binding AvailableResolution}"
                                                Height="{Binding AvailableResolution}"
                                                Background="{x:Null}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vmN:ConnectionViewModel">
                                        <v:ConnectionView/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Nodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Name="upperCanvas"
                                                Width="{Binding AvailableResolution}"
                                                Height="{Binding AvailableResolution}"
                                                Canvas.Left="0"
                                                Canvas.Top="0"
                                                Background="{x:Null}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerTheme>
                                    <ControlTheme TargetType="ContentPresenter"
                                                  x:DataType="vmN:NodeViewModel">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </ControlTheme>
                                </ItemsControl.ItemContainerTheme>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vmN:NodeViewModel">
                                        <v:NodeView/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                    </Canvas>
                </Border>
            </paz:ZoomBorder>
        </ScrollViewer>
    </DockPanel>
</UserControl>
