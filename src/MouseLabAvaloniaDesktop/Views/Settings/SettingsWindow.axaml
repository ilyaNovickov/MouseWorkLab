<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MouseLabAvaloniaDesktop.Views.SettingsWindow"
        xmlns:vm="using:MouseLabAvaloniaDesktop.ViewModels"
        xmlns:views="using:MouseLabAvaloniaDesktop.Views"
        x:DataType="vm:SettingsWindowViewModel"
        IsEnabled="{Binding IsEnable}"
        Title="SettingsWindow">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Bottom">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Classes="settingsManage" Grid.Column="1"
                        Content="{Binding Strings.CommonSave}"
                        Command="{Binding SaveCommand}" />
                <Button Classes="settingsManage" Grid.Column="2"
                        Content="{Binding Strings.CommonCancel}"
                        Command="{Binding CancelCommand}" />
            </Grid>
          </Border>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding SettingsVM}">
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm:ModelingSettingsViewModel}">
                        <views:ModelingSettingsView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AppearanceSettingsViewModel}">
                        <views:AppearanceSettingsView />
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
</Window>
