<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:paz="using:Avalonia.Controls.PanAndZoom"
             xmlns:vm="using:MouseLabAvaloniaDesktop.ViewModels"
             x:Class="MouseLabAvaloniaDesktop.Views.WorktopView"
             x:DataType="vm:WorktopViewModel">
  <DockPanel LastChildFill="True">
    <Menu DockPanel.Dock="Top">
      <TextBlock Text="Сид"/>
      <TextBox Name="seedTextBox"
               Margin="0,5,0,5"
               Width="120"
               MaxWidth="120"
               MinWidth="120"
               MaxLength="9"
               TextInputOptions.ContentType="Number"
               Text="g">
        <TextBox.InnerRightContent>
          <Button Content="✕"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="4"
                  Command="{Binding #seedTextBox.Clear}"/>
        </TextBox.InnerRightContent>
      </TextBox>
      <Button Content="Создать"/>
    </Menu>
    <Border DockPanel.Dock="Bottom" Margin="10,10,10,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Classes="center" Text="Масштаб"/>
        <TextBlock Grid.Column="2" Classes="center" Text="{Binding #zoomBorder.ZoomX, StringFormat={}{0:0.00}}"/>
        <Button Grid.Column="3" Content="Сброс" Command="{Binding #zoomBorder.FitCommand}"/>
      </Grid>
    </Border>
    <paz:ZoomBorder Name="zoomBorder"
                    DoubleClickZoomMode="ZoomToFit"
                    MinZoomX="0.2"
                    MinZoomY="0.2"
                    Background="DimGray"
                    BoundsMode="KeepContentVisible"
                    MinimumVisibleContentPercentage="0.01"
                    AutoCalculateMaxZoom="True"
                    MaxZoomPixelSize="200">
      <Grid Width="{Binding #avaibleCanvas.Width}"
            Height="{Binding #avaibleCanvas.Height}">
        <Canvas Name="innerCanvas"
                Width="1000"
                Height="1000">
          <Rectangle Width="1000"
                     Height="1000"
                     Fill="Red"/>
        </Canvas>
        <Canvas Name="avaibleCanvas"
                Width="1500"
                Height="1500"
                Background="#82008000" />
      </Grid>
    </paz:ZoomBorder>
  </DockPanel>
</UserControl>
