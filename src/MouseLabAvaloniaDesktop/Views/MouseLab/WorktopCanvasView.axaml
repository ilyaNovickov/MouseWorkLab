<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:conv="using:MouseLabAvaloniaDesktop.Converters"
             x:Class="MouseLabAvaloniaDesktop.Views.WorktopCanvasView"
             xmlns:vm="using:MouseLabAvaloniaDesktop.ViewModels"
             x:DataType="vm:WorktopCanvasViewModel">
             <UserControl.Resources>
                <conv:ReadOnlyMatrixConverter x:Key="matrixConverter" />
             </UserControl.Resources>

      <Grid Width="{Binding #avaibleCanvas.Width}"
            Height="{Binding #avaibleCanvas.Height}">
        <Canvas Name="innerCanvas"
                Width="250"
                Height="250">
          <Rectangle Width="250"
                     Height="250"
                     Fill="Red"/>
        </Canvas>
        <Image Source="{Binding Worktop, Converter={StaticResource matrixConverter}}" />
        <Canvas Name="avaibleCanvas"
                Width="{Binding WorktopAvaibleResolution, Mode=OneWay}"
                Height="{Binding WorktopAvaibleResolution, Mode=OneWay}"
                Background="#82008000" />
      </Grid>
    
</UserControl>
