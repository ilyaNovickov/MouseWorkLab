<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MouseLabAvaloniaDesktop.Views.SettingsWindow"
        xmlns:vm="using:MouseLabAvaloniaDesktop.ViewModels"
        x:DataType="vm:SettingsWindowViewModel"
        Title="SettingsWindow">

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding SettingsVM}">

          </ItemsControl>
          <!--
          <StackPanel Orientation="Vertical" >
            
            <Rectangle Fill="Aqua" Width="100" Height="100"/>
            <Rectangle Fill="Red" Width="100" Height="100"/>
            <Rectangle Fill="Brown" Width="100" Height="100"/>
            
            </StackPanel>
            -->
        </ScrollViewer>
</Window>
