<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <!-- Компилируемые привязки по умолчанию: пути в Binding проверяются на этапе
         сборки, а не в рантайме. Обязательно для NativeAOT - рефлексивные привязки
         не выживают после тримминга. -->
      <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
      <!-- Предупреждения о несовместимости с тримером/AOT -->
	  <IsTrimmable>true</IsTrimmable>
	  <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>

	  <!-- Покажет все проблемные места при сборке -->
	  <TrimmerSingleWarn>false</TrimmerSingleWarn>
	  <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	  <EnableAotAnalyzer>true</EnableAotAnalyzer>

	  <!-- Отключаем рефлексию в System.Text.Json,
         чтобы случайно не использовать несгенерированный путь -->
	  <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

	  <!-- Avalonia + AOT требуют этого -->
	  <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Translations\**" />
    <!-- SourceGenerator читает эти файлы на этапе сборки и генерирует по ним
         ProTranslateKeys, ProTranslateStrings и ProTranslateGeneratedTranslationProvider.
         Добавление языка = добавление файла Strings.<код-культуры>.json,
         пересборка проекта не требует правок в C#. -->
    <AdditionalFiles Include="Assets\Translations\Strings.*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />

    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Model.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />

    <!-- Ядро ProTranslate: культуры, переводы, fallback, форматирование, кэш. -->
    <PackageReference Include="ProTranslate.Avalonia" />
    <!-- Регистрация сервисов в IServiceCollection. -->
    <PackageReference Include="ProTranslate.MicrosoftExtensions" />

    <!-- Генератор ключей, типизированных строк и провайдера из JSON-каталогов.
         Подключается как анализатор, а не как обычная ссылка. -->
    <PackageReference Include="ProTranslate.SourceGenerator">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </PackageReference>

    <!-- Проверки на этапе сборки: PTA001 неизвестный ключ, PTA002 несовпадение
         числа плейсхолдеров, PTA003 пробел в переводе для какой-то культуры. -->
    <PackageReference Include="ProTranslate.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </PackageReference>
    <PackageReference Include="StaticViewLocator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="PanAndZoom" />

    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MouseLabAvaloniaDesktop.Generators\MouseLabAvaloniaDesktop.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\MenuView.axaml.cs">
      <DependentUpon>MenuView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Worktop\WorktopView.axaml.cs">
      <DependentUpon>WorktopView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Worktop\WorktopCanvasView.axaml.cs">
      <DependentUpon>WorktopCanvasView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
