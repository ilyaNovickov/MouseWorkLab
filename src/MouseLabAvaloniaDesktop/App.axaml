<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MouseLabAvaloniaDesktop.App"
             xmlns:local="using:MouseLabAvaloniaDesktop"
             xmlns:conv="using:MouseLabAvaloniaDesktop.Converters"
             RequestedThemeVariant="Light">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <conv:ReadOnlyMatrixConverter x:Key="MatrixToImage" />
        <conv:NumberToCornerRadiusConverter x:Key="NumberToCornerRadius" />
        <conv:PointDToPointConverter x:Key="PointDToPoint" />
        <conv:ArrowGeometryConverter x:Key="ArrowGeometry" />
        <conv:ConnectionGeometryConverter x:Key="ConnectionGeometry" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <DockFluentTheme />
        <StyleInclude Source="/Styles/SettingsStyles.axaml"/>
        <StyleInclude Source="/Styles/NodeStyles.axaml"/>
        <StyleInclude Source="/Styles/ConnectionStyles.axaml"/>
    </Application.Styles>
</Application>