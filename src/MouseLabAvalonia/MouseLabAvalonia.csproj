<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>True</PublishAot>
	<IsAotCompatible>true</IsAotCompatible>
	<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	<Platforms>AnyCPU;x64</Platforms>
	<NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>
  <PropertyGroup Label="Avalonia">
    <AvaloniaXamlIlDebuggerLaunch>False</AvaloniaXamlIlDebuggerLaunch>
    <AvaloniaXamlCreateSourceInfo>True</AvaloniaXamlCreateSourceInfo>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.2" />
	<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.6" />
    <PackageReference Include="Dock.Avalonia.Diagnostics" Version="12.1.0.6" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.6" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.1.0.6" />
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="ScottPlot.Avalonia" Version="5.1.59" />
    <PackageReference Include="StaticViewLocator" Version="0.7.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mouse.Services\Mouse.Services.csproj" />
    <ProjectReference Include="..\MouseBaseLib\MouseBaseLib.csproj" />
    <ProjectReference Include="..\MouseStdLib\MouseStdLib.csproj" />
    <ProjectReference Include="..\MouseUnsafeLib\MouseUnsafeLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\PlotView.axaml.cs">
      <DependentUpon>PlotView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\WorkSurfaceView.axaml.cs">
      <DependentUpon>WorkSurfaceView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
