<!--
    Атрибуты корневого окна:
      Title                      -> привязан к сгенерированной строке App.Title.
                                   Title только на чтение, поэтому привязка односторонняя.
      Translation.Culture        -> передаёт культуру из ViewModel в сервис ProTranslate
                                   (ICultureService). Привязка служит только для синхронизации:
                                   смена языка идёт через ICultureService.SetCulture, и уже
                                   оттуда культура возвращается сюда как Strings.Culture.
      Translation.AutoFlowDirection -> направление текста (LTR/RTL) вычисляется автоматически
                                   по культуре, поэтому для арабского или иврита окно само
                                   развернётся справа налево.
    Комментарии внутри списка атрибутов Avalonia не поддерживает, поэтому вынесены сюда.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MouseLabAvaloniaApp.ViewModels"
        xmlns:models="using:MouseLabAvaloniaApp.Models"
        xmlns:d="http://schemas.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MouseLabAvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Strings.AppTitle}"
        Translation.Culture="{Binding Strings.Culture}"
        Translation.AutoFlowDirection="True">

    <Design.DataContext>
        <!-- DataContext только для превью в IDE. Реальный DataContext
             присваивается в коде, см. App.OnFrameworkInitializationCompleted. -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <StackPanel Margin="24" Spacing="14">

        <!-- Способ 1: свойство сгенерированного ProTranslateStrings.
             SourceGenerator создаёт его по ключу App.Greeting из каталога.
             Обновляется само при смене культуры, компилируемая привязка, AOT-безопасно. -->
        <TextBlock Text="{Binding Strings.AppGreeting}" FontSize="20" />

        <!-- Способ 2: текст, собираемый в модели представления из перевода и данных.
             Ключ App.GreetingWithName содержит плейсхолдер {0}. -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Strings.SettingsUserName}" VerticalAlignment="Center" MinWidth="110" />
            <TextBox Text="{Binding UserName}" Width="180" />
        </StackPanel>
        <TextBlock Text="{Binding GreetingText}" />

        <!-- НЕ используйте здесь {Translate ...} и {Format ...}.
             Эти разметочные расширения ProTranslate создают привязку по пути-индексеру
             "[key]", который Avalonia не перевычисляет: адаптер шлёт PropertyChanged
             с именем "Item[]" (соглашение WPF), а Avalonia его игнорирует. В итоге текст
             замораживается на стартовом языке до перезапуска приложения. Кроме того,
             индексатор — это рефлексия, а значит несовместимо с NativeAOT.
             Для изменяемого текста используйте {Binding Strings.Key}. -->
        <TextBlock Text="{Binding Strings.SettingsLanguageDescription}"
                   Opacity="0.7"
                   TextWrapping="Wrap" />

        <StackPanel Spacing="10">
            <TextBlock Text="{Binding Strings.SettingsLanguage}" FontWeight="SemiBold" />

            <!-- SelectedItem связан двусторонне: выбор пользователя попадает в
                 MainWindowViewModel.SelectedCulture, который сохраняет настройку
                 и вызывает ICultureService.SetCulture. -->
            <ComboBox ItemsSource="{Binding AvailableCultures}"
                      SelectedItem="{Binding SelectedCulture}"
                      HorizontalAlignment="Left"
                      MinWidth="280">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="models:CultureOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="{Binding CurrentCultureText}" Opacity="0.7" />
        </StackPanel>

    </StackPanel>

</Window>
