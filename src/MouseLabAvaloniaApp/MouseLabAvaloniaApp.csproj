<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Компилируемые привязки по умолчанию: пути в Binding проверяются на этапе
         сборки, а не в рантайме. Обязательно для NativeAOT - рефлексивные привязки
         не выживают после тримминга. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- AOT-компиляция всех сборок Avalonia (а не только корневой). -->
	<AotAssemblies>True</AotAssemblies>
	  
	<!-- Предупреждения о несовместимости с тримером/AOT -->
	<IsTrimmable>true</IsTrimmable>
	<SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>

	  <!-- Покажет все проблемные места при сборке -->
	  <TrimmerSingleWarn>false</TrimmerSingleWarn>
	  <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	  <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- Каталоги переводов намеренно исключены: ProTranslate.SourceGenerator
         компилирует их значения прямо в сборку, поэтому в рантайме файлы не нужны. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Translations\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- SourceGenerator читает эти файлы на этапе сборки и генерирует по ним
         ProTranslateKeys, ProTranslateStrings и ProTranslateGeneratedTranslationProvider.
         Добавление языка = добавление файла Strings.<код-культуры>.json,
         пересборка проекта не требует правок в C#. -->
    <AdditionalFiles Include="Assets\Translations\Strings.*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" >
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Model.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />

    <!-- Ядро ProTranslate: культуры, переводы, fallback, форматирование, кэш. -->
    <PackageReference Include="ProTranslate.Avalonia" />
    <!-- Регистрация сервисов в IServiceCollection. -->
    <PackageReference Include="ProTranslate.MicrosoftExtensions" />

    <!-- Генератор ключей, типизированных строк и провайдера из JSON-каталогов.
         Подключается как анализатор, а не как обычная ссылка. -->
    <PackageReference Include="ProTranslate.SourceGenerator" >
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </PackageReference>

    <!-- Проверки на этапе сборки: PTA001 неизвестный ключ, PTA002 несовпадение
         числа плейсхолдеров, PTA003 пробел в переводе для какой-то культуры. -->
    <PackageReference Include="ProTranslate.Analyzers" >
      <PrivateAssets>all</PrivateAssets>
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </PackageReference>
    <PackageReference Include="StaticViewLocator" >
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\Settings\SettingsWindow.axaml.cs">
      <DependentUpon>SettingsWindow.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Settings\AppSettingsView.axaml.cs">
      <DependentUpon>AppSettingsView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\WelcomeWindow.axaml.cs">
      <DependentUpon>WelcomeWindow.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
