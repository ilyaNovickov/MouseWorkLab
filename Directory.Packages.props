<!-- Directory.Packages.props (рядом с .sln) -->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.1" />

    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Wayland" Version="12.1.3" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Dock.Avalonia" Version="12.1.0.7" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.7" />
    <PackageVersion Include="Dock.Model.Avalonia" Version="12.1.0.7" />
    <PackageVersion Include="Dock.Model.Mvvm" Version="12.1.0.7" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />

    <!-- Ядро ProTranslate: культуры, переводы, fallback, форматирование, кэш. -->
    <PackageVersion Include="ProTranslate.Avalonia" Version="0.1.0" />
    <!-- Регистрация сервисов в IServiceCollection. -->
    <PackageVersion Include="ProTranslate.MicrosoftExtensions" Version="0.1.0" />

    <!-- Генератор ключей, типизированных строк и провайдера из JSON-каталогов.
         Подключается как анализатор, а не как обычная ссылка. -->
    <PackageVersion Include="ProTranslate.SourceGenerator" Version="0.1.0" />

    <!-- Проверки на этапе сборки: PTA001 неизвестный ключ, PTA002 несовпадение
         числа плейсхолдеров, PTA003 пробел в переводе для какой-то культуры. -->
    <PackageVersion Include="ProTranslate.Analyzers" Version="0.1.0" />

    <PackageVersion Include="StaticViewLocator" Version="0.7.0" />
  </ItemGroup>
</Project>