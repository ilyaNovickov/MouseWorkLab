{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "my dotnet build (Debug)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/MouseLabSolution.slnx",
                "-c",
                "Debug",
                "/p:GenerateFullPaths=true"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "my dotnet clean",
            "type": "process",
            "command": "dotnet",
            "args": [
                "clean",
                "${workspaceFolder}/MouseLabSolution.slnx"
            ],
            "problemMatcher": []
        },
        {
            "label": "my benchmark build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/benchmark/Benchmark.MoveFinder/Benchmark.MoveFinder.csproj",
                "-c",
                "Release"
            ],
            "problemMatcher": []
        }
    ]
}