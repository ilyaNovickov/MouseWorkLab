{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dotnet build (Debug)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/MouseLabSolution.slnx",
                "-c",
                "Debug",
                "/p:GenerateFullPaths=true"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "dotnet clean",
            "type": "process",
            "command": "dotnet",
            "args": [
                "clean",
                "${workspaceFolder}/MouseLabSolution.slnx"
            ],
            "problemMatcher": []
        }
    ]
}